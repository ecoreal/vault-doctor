{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2018",
    "lib": ["DOM", "ES5", "ES6", "ES7", "ES2018", "ES2019"],
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": false,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
